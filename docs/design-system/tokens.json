{
  "version": "alpha",
  "name": "Cradle Design Language",

  "colors": {
    "background": "#ffffff",
    "background-dark": "#141414",
    "foreground": "#262626",
    "foreground-dark": "#f5f5f5",

    "chrome": "#f5f5f5",
    "chrome-dark": "#111111",
    "chrome-foreground": "#595959",
    "chrome-foreground-dark": "#8a8a8a",
    "chrome-border": "rgba(0,0,0,0.06)",
    "chrome-border-dark": "rgba(255,255,255,0.05)",

    "muted": "rgba(0,0,0,0.04)",
    "muted-dark": "rgba(255,255,255,0.04)",
    "muted-foreground": "#737373",
    "border": "rgba(0,0,0,0.08)",
    "border-dark": "rgba(255,255,255,0.06)",
    "ring": "#a3a3a3",
    "input": "rgba(0,0,0,0.10)",

    "primary": "#262626",
    "primary-dark": "#f5f5f5",

    "accent-workspace": "#3b82f6",
    "accent-session": "#8b5cf6",
    "accent-builtin": "#8b5cf6",
    "accent-global": "#0ea5e9",
    "accent-scope-workspace": "#10b981",
    "accent-doc": "#10b981",
    "accent-agent": "#f43f5e",
    "accent-legacy": "#f59e0b",
    "accent-diff": "#f97316",
    "accent-summary": "#ec4899",

    "status-success": "#10b981",
    "status-warning": "#f59e0b",
    "status-error": "#ef4444"
  },

  "textHierarchy": {
    "_comment": "Pre-resolved contrast tiers. NEVER add opacity on top of these values. Contrast ratios computed against --background (#ffffff light / #141414 dark) using WCAG 2.1 relative luminance formula.",
    "primary": {
      "light": "#262626",
      "dark": "#f5f5f5",
      "contrast-light": "15.6:1",
      "contrast-dark": "17.6:1",
      "wcag": "AAA",
      "use": "Body text, headings, primary labels — all core readable content"
    },
    "secondary": {
      "light": "#737373",
      "dark": "#a3a3a3",
      "contrast-light": "4.54:1",
      "contrast-dark": "7.5:1",
      "wcag": "AA",
      "use": "Supporting descriptions, settings body, secondary labels"
    },
    "tertiary": {
      "light": "#767676",
      "dark": "#8a8a8a",
      "contrast-light": "4.53:1",
      "contrast-dark": "5.3:1",
      "wcag": "AA",
      "use": "Metadata, timestamps, captions, scope labels — functional but non-primary",
      "_note": "Changed from #a3a3a3 (2.4:1 fail) to #767676 (4.53:1 AA pass)"
    },
    "dim": {
      "light": "#a3a3a3",
      "dark": "#525252",
      "contrast-light": "2.43:1",
      "contrast-dark": "1.6:1",
      "wcag": "Exempt",
      "use": "Decorative elements and disabled states only. WCAG 2.1 SC 1.4.3 exempts disabled components from contrast requirements. Never use for readable content."
    }
  },

  "typography": {
    "display": {
      "fontFamily": "Geist Variable",
      "fontSize": "30px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em"
    },
    "heading": {
      "fontFamily": "Geist Variable",
      "fontSize": "18px",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": "-0.01em"
    },
    "section-title": {
      "fontFamily": "Geist Variable",
      "fontSize": "16px",
      "fontWeight": 600,
      "lineHeight": 1.4
    },
    "body-lg": {
      "fontFamily": "Geist Variable",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "body-md": {
      "fontFamily": "Geist Variable",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-sm": {
      "fontFamily": "Geist Variable",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-md": {
      "fontFamily": "Geist Variable",
      "fontSize": "13px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "label-sm": {
      "fontFamily": "Geist Variable",
      "fontSize": "12px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "label-xs": {
      "fontFamily": "Geist Variable",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "caption": {
      "fontFamily": "Geist Variable",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "micro": {
      "fontFamily": "Geist Variable",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.0
    },
    "micro-mono": {
      "fontFamily": "Geist Mono",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.0
    },
    "code-sm": {
      "fontFamily": "Geist Mono",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "code-xs": {
      "fontFamily": "Geist Mono",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.0
    }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "64px",
    "sidebar-width": "260px",
    "sidebar-collapsed": "48px",
    "aside-width": "280px",
    "aside-min": "200px",
    "aside-max": "560px",
    "content-max-chat": "672px",
    "content-max-wide": "896px",
    "header-height": "40px",
    "footer-height": "36px"
  },

  "rounded": {
    "sm": "6px",
    "md": "8px",
    "base": "10px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },

  "components": {
    "content-card": {
      "background": "{colors.background}",
      "borderRadius": "{rounded.xl}",
      "boxShadow": "0 1px 2px rgba(0,0,0,0.05)",
      "margin": "4px 8px 4px 4px"
    },
    "activity-card": {
      "background": "{colors.background}",
      "borderColor": "{colors.border}",
      "borderRadius": "{rounded.lg}",
      "insetShadow": "0 1px 0 rgba(255,255,255,0.10)",
      "width": "128px"
    },
    "list-row": {
      "paddingX": "8px",
      "paddingY": "6px",
      "borderRadius": "{rounded.md}",
      "hoverBackground": "{colors.muted}",
      "fontSize": "{typography.body-sm.fontSize}"
    },
    "pill": {
      "paddingX": "12px",
      "paddingY": "4px",
      "borderRadius": "{rounded.full}",
      "borderColor": "{colors.border}",
      "fontSize": "{typography.micro.fontSize}"
    },
    "composer": {
      "background": "{colors.background}",
      "backgroundOpacity": "0.80",
      "backdropBlur": "blur(8px)",
      "borderColor": "rgba(0,0,0,0.10)",
      "borderRadius": "{rounded.xl}",
      "boxShadow": "0 1px 1px rgba(0,0,0,0.04)",
      "focusRing": "0 0 0 2px rgba(163,163,163,0.20)"
    },
    "bubble-user": {
      "background": "{colors.muted}",
      "fontSize": "{typography.body-lg.fontSize}"
    },
    "popover": {
      "background": "rgba(255,255,255,0.95)",
      "borderColor": "{colors.border}",
      "borderRadius": "{rounded.xl}",
      "boxShadow": "0 8px 32px rgba(0,0,0,0.12)",
      "backdropBlur": "blur(12px)"
    },
    "tab-pill": {
      "background": "{colors.muted}",
      "borderRadius": "{rounded.md}",
      "transition": "spring stiffness:600 damping:40"
    },
    "scope-badge": {
      "size": "28px",
      "borderRadius": "{rounded.lg}"
    },
    "section-label": {
      "color": "{textHierarchy.tertiary.light}",
      "fontSize": "{typography.micro.fontSize}",
      "fontWeight": "500",
      "_note": "Previously used muted-foreground + opacity:0.5 which produced ~1.8:1 contrast. Now uses pre-resolved tertiary tier at 4.53:1 AA."
      "fontSize": "{typography.micro.fontSize}",
      "fontWeight": "500"
    }
  },

  "animation": {
    "spring-default": {
      "type": "spring",
      "stiffness": 600,
      "damping": 40
    },
    "spring-message": {
      "type": "spring",
      "stiffness": 500,
      "damping": 35,
      "mass": 0.8
    },
    "message-enter": {
      "from": { "opacity": 0, "y": 8 },
      "to": { "opacity": 1, "y": 0 }
    },
    "sidebar-collapse": {
      "from": { "opacity": 0, "width": 0 },
      "to": { "opacity": 1, "width": "auto" }
    },
    "panel-drill-in": {
      "from": { "opacity": 0, "x": 20, "filter": "blur(4px)" },
      "to": { "opacity": 1, "x": 0, "filter": "blur(0px)" }
    }
  }
}

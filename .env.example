# ─── Cradle Server ───────────────────────────────────────────
CRADLE_DATA_DIR=./data
CRADLE_CREDENTIAL_SECRET=change-me-server-secret

# ─── Langfuse (LLM Observability) ───────────────────────────
# Self-host: docker compose up — or use cloud.langfuse.com (free tier)
# When set, all AI SDK calls are traced with full prompt/response/token data
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

{
  "name": "@cradle/desktop",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": {
    "email": "wibus_wee@outlook.com",
    "name": "wibus-wee",
    "url": "https://wibus.ren"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm build:mac-bridge && electron-vite dev",
    "build": "pnpm --filter @cradle/server build:desktop-runtime && pnpm --filter @cradle/browser-use build && pnpm build:mac-bridge && electron-vite build",
    "build:mac-bridge": "node scripts/build-mac-bridge.mjs",
    "record:appshot-parity": "node scripts/record-appshot-parity.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm build && electron-builder --dir",
    "record:preview-installer-smoke": "node scripts/record-preview-installer-smoke.mjs",
    "release:preview": "node scripts/release-preview.mjs",
    "release:preview-distribution": "node scripts/release-preview-distribution.mjs",
    "verify:macos-distribution-credentials": "node scripts/verify-macos-distribution-credentials.mjs",
    "verify:preview-distribution": "node scripts/verify-preview-distribution.mjs",
    "verify:preview-update": "node scripts/verify-preview-update.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@cradle/browser-use": "workspace:*",
    "@cradle/ipc": "workspace:*",
    "@cradle/plugin-sdk": "workspace:*",
    "electron-window-state": "^5.0.3",
    "get-port": "^7.1.0",
    "tar": "^7.5.13",
    "velopack": "0.0.1589-ga2c5a97",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
